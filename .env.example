# Copy this file to .env and edit it:  cp .env.example .env
# .env is gitignored. Never commit it, never paste a real key into this file.

# --- database ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense_local_dev
POSTGRES_DB=expenses
DATABASE_URL=postgres://expense:expense_local_dev@localhost:5432/expenses

# --- backend ---
PORT=3000
TZ=Europe/Helsinki

# How many database connections one process may hold open. 10 is the default
# and the right number here, where one container serves everything. On Vercel
# it must be 1 — see the Vercel section below.
# DB_POOL_MAX=10

# off | require | verify. Encryption for the database connection. Off is right
# for the local container: it is on a private network nothing else can reach.
# A hosted database needs "require" at least.
# DB_SSL=off

# --- ai ---
# mock   offline, needs no key. The default, and what every provider falls
#        back to if it errors, times out, or returns something invalid.
# claude needs ANTHROPIC_API_KEY below
# openai needs OPENAI_API_KEY below
AI_PROVIDER=mock

# Paste a key here only in .env, never in this example file.
# A blank value counts as not set, and the app falls back to the mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Uncomment only to override the defaults shown.
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5
# AI_TIMEOUT_MS=15000

# --- exchange rates (hour 4) ---
FX_API_URL=https://api.frankfurter.app

# Currency conversion. Off by default.
#
# off  One currency: whatever base you picked. An amount is stored exactly as
#      typed and a currency named in a sentence is ignored, so "30 quid" with a
#      euro base records 30 euros. Changing the base then only changes the
#      symbol, which makes it completely reversible.
# on   Brings back the whole conversion path — live European Central Bank rates
#      for the day the money was spent, the business-day fallback, and the fixed
#      table when the service is unreachable. None of it was deleted.
FX_CONVERSION=off

# --- mcp server (hour 4) ---
# Where the MCP server should look for the API. It runs on your own machine,
# outside Docker, so this depends on how the backend is running:
#   npm run dev            http://localhost:3000   straight to the backend
#   docker compose up      http://localhost        through Caddy, port 80
#   the deployed server    https://expenses.95-216-44-12.sslip.io
# Under compose the backend has no published port of its own on purpose, so
# everything arrives through the same front door a browser uses.
BACKEND_URL=http://localhost:3000

# --- deployment (hour 5) ---
# Leave DOMAIN blank to run locally: compose falls back to http://localhost,
# which serves plain HTTP and asks nobody for a certificate.
# On the server set it to the bare hostname and Caddy arranges HTTPS itself:
#   DOMAIN=expenses.95-216-44-12.sslip.io
DOMAIN=

# Only needed if something on this machine already holds port 80 or 443.
# On the server leave these alone: Let's Encrypt checks port 80 by name.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# --- deploying to vercel + supabase (the other way) ---
# None of these belong in this file or in .env. They are set in the Vercel
# dashboard, on the backend project, because that is where the app runs when it
# is deployed that way. They are listed here so there is one place that says
# what the deployed backend needs.
#
#   DATABASE_URL   the Supabase TRANSACTION POOLER string, port 6543, with
#                  ?sslmode=require on the end. Not the direct connection:
#                  that one is IPv6-only and Vercel cannot reach it at all.
#   DB_POOL_MAX    1
#   DB_SSL         require
#   AI_PROVIDER    mock
#   FX_CONVERSION  off
#   TZ             Europe/Helsinki
#
# Migrations are run from your own machine against the SESSION pooler string
# (port 5432), not from a build step. See the README.

# --- seeding ---
# The seed script empties the tables before it writes. It refuses to run
# unless this is exactly "true", so it can never be triggered by accident.
ALLOW_SEED=true
