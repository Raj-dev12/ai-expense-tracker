# Copy this file to .env and edit it:  cp .env.example .env
# .env is gitignored. Never commit it, never paste a real key into this file.

# --- database ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense_local_dev
POSTGRES_DB=expenses
DATABASE_URL=postgres://expense:expense_local_dev@localhost:5432/expenses

# --- backend ---
PORT=3000
TZ=Europe/Helsinki

# --- ai ---
# mock   offline, needs no key. The default, and what every provider falls
#        back to if it errors, times out, or returns something invalid.
# claude needs ANTHROPIC_API_KEY below
# openai needs OPENAI_API_KEY below
AI_PROVIDER=mock

# Paste a key here only in .env, never in this example file.
# A blank value counts as not set, and the app falls back to the mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Uncomment only to override the defaults shown.
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5
# AI_TIMEOUT_MS=15000

# --- exchange rates (hour 4) ---
FX_API_URL=https://api.frankfurter.app

# --- mcp server (hour 4) ---
# Where the MCP server should look for the API. It runs on your own machine,
# outside Docker, so this depends on how the backend is running:
#   npm run dev            http://localhost:3000   straight to the backend
#   docker compose up      http://localhost        through Caddy, port 80
#   the deployed server    https://expenses.95-216-44-12.sslip.io
# Under compose the backend has no published port of its own on purpose, so
# everything arrives through the same front door a browser uses.
BACKEND_URL=http://localhost:3000

# --- deployment (hour 5) ---
# Leave DOMAIN blank to run locally: compose falls back to http://localhost,
# which serves plain HTTP and asks nobody for a certificate.
# On the server set it to the bare hostname and Caddy arranges HTTPS itself:
#   DOMAIN=expenses.95-216-44-12.sslip.io
DOMAIN=

# Only needed if something on this machine already holds port 80 or 443.
# On the server leave these alone: Let's Encrypt checks port 80 by name.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# --- seeding ---
# The seed script empties the tables before it writes. It refuses to run
# unless this is exactly "true", so it can never be triggered by accident.
ALLOW_SEED=true
